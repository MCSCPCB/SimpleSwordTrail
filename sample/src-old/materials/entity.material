{
  "materials": {
    "version": "1.0.0",
    "sword_trail_item_base:entity": {
      "-defines": [
        "FANCY"
      ]
    },
    "sword_trail_item_glint:sword_trail_item_base": {
      "+defines": [
        "GLINT"
      ],
      "+samplerStates": [
        {
          "samplerIndex": 0,
          "textureFilter": "Point"
        },
        {
          "samplerIndex": 1,
          "textureWrap": "Repeat"
        }
      ]
    },
    "sword_trail_additive:entity_emissive": {
      "+states": [
        "Blending",
        "DisableCulling",
        "DisableDepthWrite"
      ],
      "+defines": [
        "USE_UV_ANIM"
      ],
      "-defines": [
        "FANCY"
      ],
      "blendSrc": "One",
      "blendDst": "One"
    },
    "sword_trail_repeat:sword_trail_additive": {
      "blendSrc": "SourceAlpha",
      "+samplerStates": [
        {
          "samplerIndex": 0,
          "textureWrap": "Repeat"
        }
      ]
    },
    "sword_trail_ribbon:sword_trail_repeat": {
      "+samplerStates": [
        {
          "samplerIndex": 0,
          "textureFilter": "Bilinear"
        }
      ]
    }
  }
}
